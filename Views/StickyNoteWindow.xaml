<Window x:Class="Blot.Views.StickyNoteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Blot" Width="280" Height="300" MinWidth="170" MinHeight="150"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="CanResizeWithGrip" ShowInTaskbar="False">
  <Window.Resources>
    <Style x:Key="Tb" TargetType="Button">
      <Setter Property="Width" Value="24"/><Setter Property="Height" Value="24"/>
      <Setter Property="Background" Value="Transparent"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}" CornerRadius="3">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#22000000"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>
  <Grid>
    <!-- Layer 1: note colour (shows through transparent parts of the JPEG) -->
    <Border x:Name="ColorLayer"/>
    <!-- Layer 2: the JPEG template is ONLY a background -->
    <Image x:Name="Bg" Stretch="Fill" IsHitTestVisible="False"/>

    <!-- Header: drag handle + note actions -->
    <Grid x:Name="Header" VerticalAlignment="Top" Height="28" Background="#01000000"
          MouseLeftButtonDown="Header_Drag">
      <Button Style="{StaticResource Tb}" Content="+" HorizontalAlignment="Left" Margin="8,2,0,0" Click="New_Click" ToolTip="New note"/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,2,8,0">
        <Button x:Name="PinBtn" Style="{StaticResource Tb}" Content="📌" Click="Pin_Click" ToolTip="Always on top"/>
        <Button Style="{StaticResource Tb}" Content="🎨" Click="Palette_Click" ToolTip="Colour &amp; appearance"/>
        <Button Style="{StaticResource Tb}" Content="✕" Click="Delete_Click" ToolTip="Delete note"/>
      </StackPanel>
    </Grid>

    <!-- Layer 3: transparent editor sitting inside the template's editable region -->
    <RichTextBox x:Name="Editor" Background="Transparent" BorderThickness="0"
                 AcceptsTab="True" IsDocumentEnabled="True" FontSize="14"
                 FontFamily="Segoe UI" VerticalScrollBarVisibility="Auto"
                 Margin="16,34,16,34">
      <RichTextBox.Resources>
        <Style TargetType="Paragraph"><Setter Property="Margin" Value="0"/></Style>
      </RichTextBox.Resources>
    </RichTextBox>

    <!-- Format bar -->
    <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="12,0,0,6">
      <Button Style="{StaticResource Tb}" Command="EditingCommands.ToggleBold" CommandTarget="{Binding ElementName=Editor}" ToolTip="Bold (Ctrl+B)"><TextBlock Text="B" FontWeight="Bold"/></Button>
      <Button Style="{StaticResource Tb}" Command="EditingCommands.ToggleItalic" CommandTarget="{Binding ElementName=Editor}" ToolTip="Italic (Ctrl+I)"><TextBlock Text="I" FontStyle="Italic"/></Button>
      <Button Style="{StaticResource Tb}" Command="EditingCommands.ToggleBullets" CommandTarget="{Binding ElementName=Editor}" Content="•≡" ToolTip="Bulleted list"/>
      <Button Style="{StaticResource Tb}" Command="EditingCommands.ToggleNumbering" CommandTarget="{Binding ElementName=Editor}" Content="1." ToolTip="Numbered list"/>
      <Button Style="{StaticResource Tb}" Click="Check_Click" Content="☑" ToolTip="Insert checkbox"/>
    </StackPanel>
  </Grid>
</Window>
